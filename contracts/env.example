# Variáveis de ambiente da Bússola (contratos §7). Copie para .env (ignorado pelo git) e ajuste.
# NUNCA coloque valores secretos aqui: este arquivo é versionado.

# --- ambos os serviços ---
GOOGLE_CLOUD_PROJECT=batalha-time-07-lkbv
GOOGLE_CLOUD_LOCATION=us-central1
BUSSOLA_FAKES=TRUE
LOG_LEVEL=INFO
PORT=8080

# --- agent / rag ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Só no Plano B (Gemini API). NUNCA versionar; o valor vem do Secret Manager (`gemini-api-key`).
GOOGLE_API_KEY=

# --- agent ---
# Preenchido por deploy/smoke_modelos.py (ciclo 000). Candidatos, em ordem: gemini-3.8-flash, gemini-3.7-flash, gemini-3.5-flash.
BUSSOLA_MODEL=
MCP_URL=http://localhost:8080/mcp
# FALSE local; TRUE no Cloud Run.
MCP_USE_OIDC=FALSE
# Vazio = fallback de callbacks (sem Model Armor).
MODEL_ARMOR_TEMPLATE=
ANCHOR_USER_ID=36a21505-d6d4-42d3-b319-d51a133c7269
REPLAY_START_ANOMES=202506

# --- mcp / rag ---
# Preenchido por deploy/smoke_modelos.py. Candidatos: gemini-embedding-001, text-embedding-005.
EMBEDDING_MODEL=
# Testes usam bussola_app_dev.
BQ_DATASET_DADOS=bussola_dados
BQ_DATASET_RAG=bussola_rag
BQ_DATASET_APP=bussola_app
# query | memoria
BQ_MODO_LEITURA=query
# bq | numpy
RAG_BACKEND=bq
